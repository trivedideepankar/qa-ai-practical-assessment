{
  "name": "qa-ai-practical-assessment-prism",
  "version": "1.0.0",
  "description": "Prism Playwright framework for Practice Software Testing Toolshop assessment",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --project=testcases_regression",
    "test:smoke": "npx playwright test --project=testcases_smoke --grep @smoke",
    "test:regression": "npx playwright test --project=testcases_regression --grep @regression",
    "test:ui": "npx playwright test tests/UI\\ Test/",
    "test:api": "npx playwright test tests/API\\ Test/",
    "test:headed": "npx playwright test --headed --project=testcases_regression",
    "report": "npx playwright show-report",
    "post:xray:xml": "node commonUtils/xrayConvert.js",
    "post:test:xray": "npm run post:xray:xml && node commonUtils/xrayConfig.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.6.2"
  },
  "dependencies": {
    "@playwright/browser-chromium": "^1.40.0",
    "allure-playwright": "^2.4.0",
    "axios": "^1.7.4",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.46.0",
    "faker": "^5.5.3",
    "fs": "^0.0.1-security",
    "Logger": "^0.0.0",
    "mysql": "^2.18.1",
    "path": "^0.12.7",
    "pdf-parse": "^1.1.1",
    "winston": "^3.14.2",
    "xml2js": "^0.6.2"
  }
}
